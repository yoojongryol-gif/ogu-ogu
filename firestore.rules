rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 오구오구(5959): 계정 없음(익명 auth uid만). pairs/{pairId} = 커플 한 쌍(또는 솔로 1인).
    //   status: "solo"(1명, 혼자 둘러보며 초대 대기) -> "paired"(2명 완료) -> "dissolved"(관계 정리, 툼스톤)
    //     · "solo"는 페어링 게이트 없이 바로 입장해 전 기능(채팅/꾸미기/잠금)을 쓰는 상태.
    //       나중에 초대코드로 짝이 합류하면 같은 문서가 그대로 paired로 승격 → 솔로 시절 기록/꾸미기 유지.
    //     · 과거 "waiting"(구 페어링 대기) 문서와의 하위호환: 합류 규칙은 solo/waiting 둘 다 수용.
    //   code/codeExpiresAt: 초대코드(6자리, 만료). 솔로 멤버가 언제든 재발급 가능(케이스 I).
    //   theme/profile: "둘이 함께 꾸미기" 동기화 필드(멤버만 갱신, 값은 취향 데이터).
    //   rejoin*: 짝 도움 복귀(partner re-invite) — 저장소를 잃은 쪽이 기존 자리를 승계하기 위한 1회용 코드.
    function signedIn() { return request.auth != null; }
    function isMember(pairData) {
      return signedIn() && pairData.memberUids.hasAny([request.auth.uid]);
    }
    function pairOf(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }
    function pairMembers(pid) {
      return get(/databases/$(database)/documents/pairs/$(pid)).data.memberUids;
    }

    // ── codeIndex/{code} : 코드→pairId 역인덱스 (보안 재설계 2026-08-05) ──────────
    //   문서 id = 6자리 코드 그 자체. 코드를 아는 자만 doc-id get으로 pairId를 얻는다.
    //   ★ list 전면 금지 → where(status/rejoinOpen/code) 컬렉션 열거로 코드를 수확하던 경로(V1/V2) 봉합.
    //   쓰기는 "대상 pair의 멤버"만 → 남의 pair를 가리키는 코드 위조 불가.
    //   type: "invite"(솔로 초대) | "rejoin"(짝 도움 복귀). createdBy=발급 멤버(rejoin이면 생존자).
    match /codeIndex/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["pairId","type","expiresAt","createdBy"])
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.type == "invite" || request.resource.data.type == "rejoin")
        && request.resource.data.pairId is string
        && request.resource.data.expiresAt is int
        && (request.auth.uid in pairMembers(request.resource.data.pairId));
      allow update: if signedIn()
        && request.resource.data.pairId == resource.data.pairId          // 다른 pair로 재지정 금지(도용 차단)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(["pairId","type","expiresAt","createdBy"])
        && (request.auth.uid in pairMembers(resource.data.pairId));
      allow delete: if signedIn()
        && (request.auth.uid in pairMembers(resource.data.pairId));
    }

    match /pairs/{pairId} {
      // 읽기(get/list 분리) — 보안 재설계 2026-08-05.
      //   get: 이미 멤버이거나, "본인이 합류요청(joinRequest)을 걸어둔 대기 요청자"만 단건 조회(수락/거절 관측용).
      //        (구 solo/waiting/rejoinOpen 무조건 read 삭제 — 열거 누출 봉합.)
      //   list: 유일 컬렉션 쿼리 = where("memberUids","array-contains",내uid). 자기 uid로만 규칙 증명 성립 →
      //         where("status","==","solo")·where("rejoinOpen","==",true) 류 열거는 거부된다.
      allow get: if isMember(resource.data)
        || (("joinRequest" in resource.data) && resource.data.joinRequest.uid == request.auth.uid);
      allow list: if signedIn() && (request.auth.uid in resource.data.memberUids);

      // 생성: 본인 uid 1명 솔로로 시작 (페어링 게이트 없이 바로 입장). 짝은 초대코드로 나중에 합류.
      allow create: if signedIn()
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.status == "solo";

      // 이별 프로토콜(v1): 일단 dissolved로 전환된 문서는 그 무엇으로도 되돌리거나 추가 수정할 수 없다(툼스톤 고정).
      //   → 전체 allow update에 "현재 상태가 dissolved가 아닐 것"을 선행 조건으로 건다.
      //   이 선행 조건 덕분에 dissolved 페어에는 재합류 승계(케이스 G)도 원천 차단된다(이별 프로토콜 유지).
      allow update: if signedIn() && resource.data.status != "dissolved" && (
        // 케이스 D: 읽음 확인(lastReadAt) — 본인 uid 키만 갱신 가능, 상대 값은 건드릴 수 없다.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastReadAt"])
          && (!("lastReadAt" in resource.data)
              || resource.data.lastReadAt.diff(request.resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])))
        ||
        // 케이스 D': 알림용 FCM 토큰 등록 — 본인 uid 키만 갱신 가능(2단계 A, 알림 내용 숨김 훅의 전제).
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fcmTokens"])
          && (!("fcmTokens" in resource.data)
              || resource.data.fcmTokens.diff(request.resource.data.fcmTokens).affectedKeys().hasOnly([request.auth.uid])))
        ||
        // 케이스 E: 꾸미기(테마/프로필) — 멤버만, theme/profile 필드만 갱신. 멤버·상태 불변.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["theme","profile"]))
        ||
        // 케이스 J: 사진 카운트(커플당 50장 캡 관리) — 멤버만, photoCount 필드만, 0~50 정수.
        //   ⚠️정직한 한계: rules는 photos 서브컬렉션 문서 수를 셀 수 없어 "실제 사진 수 == photoCount"를
        //   완전 강제하지 못한다(클라이언트가 카운트를 정직히 올린다는 전제). 다만 photoCount 자체의
        //   상한(<=50)은 rules로 강제되어, 이 값을 근거로 한 캡 UX가 50을 넘겨 기록되는 일은 막는다.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photoCount"])
          && request.resource.data.photoCount is int
          && request.resource.data.photoCount >= 0
          && request.resource.data.photoCount <= 50)
        ||
        // 케이스 R: 비멤버가 "합류 요청"만 기록(joinRequest 필드). 수락 전 접근은 여기서 끝난다.
        //   ★보안 핵심(사장님 "코드만 있으면 다 들어오나?" 대응): 이 케이스는 memberUids/status를 절대 바꾸지
        //   못하므로 요청자는 여전히 "비멤버"다 → 메시지·일정·다이어리·사진(전부 isMember 게이트)과 테마 수정에
        //   접근할 수 없다. 오직 joinRequest 필드만 쓸 수 있고, 코드 소지(joinRequest.code==code)와 본인 uid를
        //   증명해야 한다(만료 코드로는 요청 불가). 멤버의 수락(케이스 B)이 있어야만 paired가 된다.
        ((resource.data.status == "solo" || resource.data.status == "waiting")
          && resource.data.memberUids.size() == 1
          && !(request.auth.uid in resource.data.memberUids)
          && (!("codeExpiresAt" in resource.data) || request.time.toMillis() < resource.data.codeExpiresAt)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["joinRequest"])
          && ("joinRequest" in request.resource.data)
          && request.resource.data.joinRequest.uid == request.auth.uid
          && request.resource.data.joinRequest.code == resource.data.code)
        ||
        // 케이스 R-cancel: 요청자가 본인 합류 요청을 취소(joinRequest 소거). 멤버·상태·코드 불변.
        (("joinRequest" in resource.data)
          && resource.data.joinRequest.uid == request.auth.uid
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["joinRequest"])
          && !("joinRequest" in request.resource.data))
        ||
        // 케이스 B: 멤버가 합류 요청을 "수락" → paired 승격(기존 "코드만 있으면 즉시 합류"를 대체).
        //   기존 1인 보존(hasAll) + 요청자(joinRequest.uid) 추가로 정확히 2명, 상태 paired, joinRequest 소거.
        //   hasAny([joinRequest.uid])로 "추가되는 2번째 멤버 = 요청자"를 강제(임의 uid 끼워넣기 차단).
        //   코드 만료 방어 유지.
        (isMember(resource.data)
          && (resource.data.status == "solo" || resource.data.status == "waiting")
          && resource.data.memberUids.size() == 1
          && ("joinRequest" in resource.data)
          && (!("codeExpiresAt" in resource.data) || request.time.toMillis() < resource.data.codeExpiresAt)
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([resource.data.joinRequest.uid])
          && request.resource.data.status == "paired"
          && !("joinRequest" in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids","status","joinRequest"]))
        ||
        // 케이스 I: 솔로/구대기 멤버가 코드 재발급 또는 합류 요청 "거절". 멤버·상태 불변.
        //   허용 필드: code/codeExpiresAt(재발급) + joinRequest(거절=소거). 거절 시 보통 코드를 함께 회전해 무효화.
        //   waiting 수용은 구세대 pair 하위호환(케이스 B/R과 대칭).
        (isMember(resource.data)
          && (resource.data.status == "solo" || resource.data.status == "waiting")
          && request.resource.data.status == resource.data.status
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["code","codeExpiresAt","joinRequest"]))
        ||
        // 케이스 C: 관계 정리(이별 프로토콜) — 어느 쪽 멤버든 단독 실행 가능. 상대 동의 불필요(설계 철학: 인질 방지).
        //   멤버 목록은 불변, status/dissolvedAt/dissolvedBy 필드만 갱신 가능(다른 필드 끼워넣기 차단).
        (isMember(resource.data)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == "dissolved"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","dissolvedAt","dissolvedBy"]))
        ||
        // 케이스 F: 짝 도움 복귀 — 재초대 열기/취소. 살아있는 멤버(현재 멤버)만, paired 상태에서.
        //   rejoin* 필드만 갱신하며 멤버·상태는 불변. rejoinReplaces(승계될 잃은 자리)는 반드시 현재 멤버 uid여야 한다.
        //   → 초대를 여는 주체가 "잃은 자리"를 지목하므로, 뒤의 케이스 G에서 제3자는 그 자리 외엔 손댈 수 없다.
        (isMember(resource.data)
          && resource.data.status == "paired"
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["rejoinOpen","rejoinCode","rejoinExpiresAt","rejoinReplaces"])
          && (!("rejoinReplaces" in request.resource.data)
              || (request.resource.data.rejoinReplaces in resource.data.memberUids)))
        ||
        // 케이스 G: 새 기기(새 uid)가 "잃은 자리"를 승계. 서버 0줄, rules만으로 안전 구현.
        //   ★코드 검증(2026-08-05 치명 취약점 V1 수리): 승계 write는 rejoinProof(입력한 rejoin 코드)를 실어야 하고,
        //     rejoinProof == resource.data.rejoinCode 여야 한다 → 코드를 모르면 승계 불가(무코드 탈취 원천 차단).
        //     비멤버는 pair를 read 못 하므로 rejoinCode를 볼 수 없다 → codeIndex로 pairId만 얻고 코드는 out-of-band(짝이 알려줌).
        //   - rejoinOpen==true + 미만료(TTL)일 때만.
        //   - 나는 진짜 새 uid(기존 멤버가 아님)여야 하고, 결과 멤버는 정확히 2명.
        //   - 살아있는 멤버(=rejoinReplaces 제외한 기존 멤버)는 반드시 보존 → 활성 자리 탈취 불가.
        //   - 잃은 자리(rejoinReplaces)는 결과에서 비워짐 → 딱 그 자리만 교체.
        //   - 초대는 즉시 소비(rejoinOpen=false)되어 1회용. 잃은 uid의 stale lastReadAt/fcmTokens 정리 허용.
        (("rejoinOpen" in resource.data) && resource.data.rejoinOpen == true
          && ("rejoinCode" in resource.data)
          && ("rejoinProof" in request.resource.data)
          && request.resource.data.rejoinProof == resource.data.rejoinCode
          && resource.data.rejoinExpiresAt > request.time.toMillis()
          && resource.data.status == "paired"
          && request.resource.data.status == "paired"
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAny([request.auth.uid])
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.hasAll(
               resource.data.memberUids.removeAll([resource.data.rejoinReplaces]))
          && !(resource.data.rejoinReplaces in request.resource.data.memberUids)
          && request.resource.data.rejoinOpen == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["memberUids","rejoinOpen","rejoinCode","rejoinExpiresAt","rejoinReplaces","rejoinProof","lastReadAt","fcmTokens"]))
      );
      // pairs 문서 자체는 삭제하지 않는다(툼스톤 유지) — 양쪽 클라이언트가 실시간으로 "dissolved"
      // 상태를 관측해 각자 로컬 정리를 마칠 수 있어야 하므로, 문서가 통째로 사라지면 그 관측이 불가능해진다.
      allow delete: if false;

      match /messages/{msgId} {
        // 승계(케이스 G) 즉시 새 uid가 memberUids에 들어가므로, 과거 메시지 전체를 삭제·복사 없이 그대로 읽는다.
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId)) && request.resource.data.sender == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        allow update: if false;
        // 삭제는 이별 프로토콜(관계 정리) 완료 후에만 허용 — 그 전에는 어느 쪽도 상대 몰래
        // 개별 메시지를 지울 수 없다(증거 인멸 방지, "인질 방지"의 반대 방향 오남용 차단).
        allow delete: if isMember(pairOf(pairId)) && pairOf(pairId).status == "dissolved";

        // 채팅 사진 원본(Bytes) — 다이어리 photos와 동일 규격. 멤버 전용. 이별(dissolved) 시 소거 허용.
        //   메시지 문서 자체엔 인라인 썸네일(thumb.bytes)만, 원본은 여기에. 캡은 pair.photoCount(케이스 J)로 공용.
        match /photos/{photoId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.authorUid == request.auth.uid
            && pairOf(pairId).status != "dissolved";
          allow update: if false;
          allow delete: if isMember(pairOf(pairId))
            && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");
        }
      }

      // ── 일정(events) ────────────────────────────────────────────────
      //   읽기: 멤버(상태 무관 — 과거 기록 승계 열람). 생성: 멤버 & 본인 & dissolved 아님.
      //   수정/삭제: 본인 것(일상적 일정 취소·오타 수정) 또는 이별(dissolved) 시 소거.
      //   ⚠️ dissolved delete 허용이 "인질 방지 철학 구멍" 봉합 — messages와 동일하게 이별 시 서버 잔존 방지.
      match /events/{eventId} {
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId))
          && request.resource.data.createdBy == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        allow update: if isMember(pairOf(pairId))
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && pairOf(pairId).status != "dissolved";
        allow delete: if isMember(pairOf(pairId))
          && (resource.data.createdBy == request.auth.uid || pairOf(pairId).status == "dissolved");
      }

      // ── 다이어리(diary) ─────────────────────────────────────────────
      //   엔트리: 글 + 인라인 썸네일(thumbs[].bytes). 둘 다 작성·열람, 본인 것 수정/삭제.
      match /diary/{entryId} {
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId))
          && request.resource.data.authorUid == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        allow update: if isMember(pairOf(pairId))
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && pairOf(pairId).status != "dissolved";
        allow delete: if isMember(pairOf(pairId))
          && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");

        // 원본 사진(Bytes) — 탭할 때만 read. 문서 1MiB 상한은 Firestore가 자체 강제(초과 write 거부).
        match /photos/{photoId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.authorUid == request.auth.uid
            && pairOf(pairId).status != "dissolved";
          allow update: if false;
          allow delete: if isMember(pairOf(pairId))
            && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");
        }
      }
    }
  }
}
