rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 오구오구(5959): 계정 없음(익명 auth uid만). pairs/{pairId} = 커플 한 쌍(또는 솔로 1인).
    //   status: "solo"(1명, 혼자 둘러보며 초대 대기) -> "paired"(2명 완료) -> "dissolved"(관계 정리, 툼스톤)
    //     · "solo"는 페어링 게이트 없이 바로 입장해 전 기능(채팅/꾸미기/잠금)을 쓰는 상태.
    //       나중에 초대코드로 짝이 합류하면 같은 문서가 그대로 paired로 승격 → 솔로 시절 기록/꾸미기 유지.
    //     · 과거 "waiting"(구 페어링 대기) 문서와의 하위호환: 합류 규칙은 solo/waiting 둘 다 수용.
    //   code/codeExpiresAt: 초대코드(6자리, 만료). 솔로 멤버가 언제든 재발급 가능(케이스 I).
    //   theme/profile: "둘이 함께 꾸미기" 동기화 필드(멤버만 갱신, 값은 취향 데이터).
    //   rejoin*: 짝 도움 복귀(partner re-invite) — 저장소를 잃은 쪽이 기존 자리를 승계하기 위한 1회용 코드.
    function signedIn() { return request.auth != null; }
    function isMember(pairData) {
      return signedIn() && pairData.memberUids.hasAny([request.auth.uid]);
    }
    function pairOf(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }
    function pairMembers(pid) {
      return get(/databases/$(database)/documents/pairs/$(pid)).data.memberUids;
    }

    // ── codeIndex/{code} : 코드→pairId 역인덱스 (보안 재설계 2026-08-05) ──────────
    //   문서 id = 6자리 코드 그 자체. 코드를 아는 자만 doc-id get으로 pairId를 얻는다.
    //   ★ list 전면 금지 → where(status/rejoinOpen/code) 컬렉션 열거로 코드를 수확하던 경로(V1/V2) 봉합.
    //   쓰기는 "대상 pair의 멤버"만 → 남의 pair를 가리키는 코드 위조 불가.
    //   type: "invite"(솔로 초대) | "rejoin"(짝 도움 복귀). createdBy=발급 멤버(rejoin이면 생존자).
    match /codeIndex/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["pairId","type","expiresAt","createdBy"])
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.type == "invite" || request.resource.data.type == "rejoin")
        && request.resource.data.pairId is string
        && request.resource.data.expiresAt is int
        && (request.auth.uid in pairMembers(request.resource.data.pairId));
      allow update: if signedIn()
        && request.resource.data.pairId == resource.data.pairId          // 다른 pair로 재지정 금지(도용 차단)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(["pairId","type","expiresAt","createdBy"])
        && (request.auth.uid in pairMembers(resource.data.pairId));
      allow delete: if signedIn()
        && (request.auth.uid in pairMembers(resource.data.pairId));
    }

    match /pairs/{pairId} {
      // 읽기(get/list 분리) — 보안 재설계 2026-08-05.
      //   get: 이미 멤버이거나, "본인이 합류요청(joinRequest)을 걸어둔 대기 요청자"만 단건 조회(수락/거절 관측용).
      //        (구 solo/waiting/rejoinOpen 무조건 read 삭제 — 열거 누출 봉합.)
      //   list: 유일 컬렉션 쿼리 = where("memberUids","array-contains",내uid). 자기 uid로만 규칙 증명 성립 →
      //         where("status","==","solo")·where("rejoinOpen","==",true) 류 열거는 거부된다.
      allow get: if isMember(resource.data)
        || (("joinRequest" in resource.data) && resource.data.joinRequest.uid == request.auth.uid);
      allow list: if signedIn() && (request.auth.uid in resource.data.memberUids);

      // 생성: 본인 uid 1명 솔로로 시작 (페어링 게이트 없이 바로 입장). 짝은 초대코드로 나중에 합류.
      //   ★premium 금지(2026-08-19 응원팩): premium은 "입금 확인한 관리자(Admin SDK)"만 켤 수 있는 필드다.
      //     update 경로들은 모두 diff().affectedKeys().hasOnly([...])로 필드를 화이트리스트하므로 premium이
      //     끼어들 수 없지만, create에는 필드 제한이 없어 "처음부터 premium:true인 pair"를 만들 수 있었다.
      //     이 한 줄이 그 유일한 클라이언트 쓰기 경로를 막는다(= premium은 클라이언트에게 읽기 전용).
      allow create: if signedIn()
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.status == "solo"
        && !("premium" in request.resource.data);

      // 이별 프로토콜(v1): 일단 dissolved로 전환된 문서는 그 무엇으로도 되돌리거나 추가 수정할 수 없다(툼스톤 고정).
      //   → 전체 allow update에 "현재 상태가 dissolved가 아닐 것"을 선행 조건으로 건다.
      //   이 선행 조건 덕분에 dissolved 페어에는 재합류 승계(케이스 G)도 원천 차단된다(이별 프로토콜 유지).
      allow update: if signedIn() && resource.data.status != "dissolved" && (
        // 케이스 D: 읽음 확인(lastReadAt) — 본인 uid 키만 갱신 가능, 상대 값은 건드릴 수 없다.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastReadAt"])
          && (!("lastReadAt" in resource.data)
              || resource.data.lastReadAt.diff(request.resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])))
        ||
        // 케이스 D': 알림용 FCM 토큰 등록 — 본인 uid 키만 갱신 가능(2단계 A, 알림 내용 숨김 훅의 전제).
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fcmTokens"])
          && (!("fcmTokens" in resource.data)
              || resource.data.fcmTokens.diff(request.resource.data.fcmTokens).affectedKeys().hasOnly([request.auth.uid])))
        ||
        // 케이스 D'': 알림 세부설정(일정 등록/일정 날짜변경/다이어리, 2026-09-30 사장님 지시) — D'와
        //   완전히 같은 패턴. 본인 uid 키만 갱신 가능(상대의 알림 취향을 몰래 끄거나 켤 수 없다).
        //   값 자체(스케줄on/오프 등)는 클라이언트 판단 영역이라 rules는 "누구 것만 고칠 수 있는가"만 본다.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notifyPrefs"])
          && (!("notifyPrefs" in resource.data)
              || resource.data.notifyPrefs.diff(request.resource.data.notifyPrefs).affectedKeys().hasOnly([request.auth.uid])))
        ||
        // 케이스 E: 꾸미기(테마/프로필) — 멤버만, theme/profile 필드만 갱신. 멤버·상태 불변.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["theme","profile"]))
        ||
        // 케이스 J: 사진 카운트(커플당 캡 관리) — 멤버만, photoCount 필드만, 0~캡 정수.
        //   캡 = 무료 50장 / 응원팩 구매 커플(premium==true) 150장 (2026-08-19).
        //   premium은 이 문서의 기존 값(resource.data)에서 읽는다 — 같은 write로 premium을 켜면서 캡을 올리는
        //   자기승격은 불가능하다(affectedKeys hasOnly(["photoCount"])가 premium 동시 변경을 이미 막고,
        //   premium 단독 변경 경로도 존재하지 않는다).
        //   ⚠️정직한 한계: rules는 photos 서브컬렉션 문서 수를 셀 수 없어 "실제 사진 수 == photoCount"를
        //   완전 강제하지 못한다(클라이언트가 카운트를 정직히 올린다는 전제). 다만 photoCount 자체의
        //   상한은 rules로 강제되어, 이 값을 근거로 한 캡 UX가 상한을 넘겨 기록되는 일은 막는다.
        (isMember(resource.data) && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photoCount"])
          && request.resource.data.photoCount is int
          && request.resource.data.photoCount >= 0
          && request.resource.data.photoCount <= (resource.data.get("premium", false) == true ? 150 : 50))
        ||
        // 케이스 R: 비멤버가 "합류 요청"만 기록(joinRequest 필드). 수락 전 접근은 여기서 끝난다.
        //   ★보안 핵심(사장님 "코드만 있으면 다 들어오나?" 대응): 이 케이스는 memberUids/status를 절대 바꾸지
        //   못하므로 요청자는 여전히 "비멤버"다 → 메시지·일정·다이어리·사진(전부 isMember 게이트)과 테마 수정에
        //   접근할 수 없다. 오직 joinRequest 필드만 쓸 수 있고, 코드 소지(joinRequest.code==code)와 본인 uid를
        //   증명해야 한다(만료 코드로는 요청 불가). 멤버의 수락(케이스 B)이 있어야만 paired가 된다.
        ((resource.data.status == "solo" || resource.data.status == "waiting")
          && resource.data.memberUids.size() == 1
          && !(request.auth.uid in resource.data.memberUids)
          && (!("codeExpiresAt" in resource.data) || request.time.toMillis() < resource.data.codeExpiresAt)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["joinRequest"])
          && ("joinRequest" in request.resource.data)
          && request.resource.data.joinRequest.uid == request.auth.uid
          && request.resource.data.joinRequest.code == resource.data.code)
        ||
        // 케이스 R-cancel: 요청자가 본인 합류 요청을 취소(joinRequest 소거). 멤버·상태·코드 불변.
        (("joinRequest" in resource.data)
          && resource.data.joinRequest.uid == request.auth.uid
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["joinRequest"])
          && !("joinRequest" in request.resource.data))
        ||
        // 케이스 B: 멤버가 합류 요청을 "수락" → paired 승격(기존 "코드만 있으면 즉시 합류"를 대체).
        //   기존 1인 보존(hasAll) + 요청자(joinRequest.uid) 추가로 정확히 2명, 상태 paired, joinRequest 소거.
        //   hasAny([joinRequest.uid])로 "추가되는 2번째 멤버 = 요청자"를 강제(임의 uid 끼워넣기 차단).
        //   코드 만료 방어 유지.
        (isMember(resource.data)
          && (resource.data.status == "solo" || resource.data.status == "waiting")
          && resource.data.memberUids.size() == 1
          && ("joinRequest" in resource.data)
          && (!("codeExpiresAt" in resource.data) || request.time.toMillis() < resource.data.codeExpiresAt)
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([resource.data.joinRequest.uid])
          && request.resource.data.status == "paired"
          && !("joinRequest" in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids","status","joinRequest"]))
        ||
        // 케이스 I: 솔로/구대기 멤버가 코드 재발급 또는 합류 요청 "거절". 멤버·상태 불변.
        //   허용 필드: code/codeExpiresAt(재발급) + joinRequest(거절=소거). 거절 시 보통 코드를 함께 회전해 무효화.
        //   waiting 수용은 구세대 pair 하위호환(케이스 B/R과 대칭).
        (isMember(resource.data)
          && (resource.data.status == "solo" || resource.data.status == "waiting")
          && request.resource.data.status == resource.data.status
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["code","codeExpiresAt","joinRequest"]))
        ||
        // 케이스 C: 관계 정리(이별 프로토콜) — 어느 쪽 멤버든 단독 실행 가능. 상대 동의 불필요(설계 철학: 인질 방지).
        //   멤버 목록은 불변, status/dissolvedAt/dissolvedBy 필드만 갱신 가능(다른 필드 끼워넣기 차단).
        (isMember(resource.data)
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == "dissolved"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","dissolvedAt","dissolvedBy"]))
        ||
        // 케이스 F: 짝 도움 복귀 — 재초대 열기/취소. 살아있는 멤버(현재 멤버)만, paired 상태에서.
        //   rejoin* 필드만 갱신하며 멤버·상태는 불변. rejoinReplaces(승계될 잃은 자리)는 반드시 현재 멤버 uid여야 한다.
        //   → 초대를 여는 주체가 "잃은 자리"를 지목하므로, 뒤의 케이스 G에서 제3자는 그 자리 외엔 손댈 수 없다.
        (isMember(resource.data)
          && resource.data.status == "paired"
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["rejoinOpen","rejoinCode","rejoinExpiresAt","rejoinReplaces"])
          && (!("rejoinReplaces" in request.resource.data)
              || (request.resource.data.rejoinReplaces in resource.data.memberUids)))
        ||
        // 케이스 G: 새 기기(새 uid)가 "잃은 자리"를 승계. 서버 0줄, rules만으로 안전 구현.
        //   ★코드 검증(2026-08-05 치명 취약점 V1 수리): 승계 write는 rejoinProof(입력한 rejoin 코드)를 실어야 하고,
        //     rejoinProof == resource.data.rejoinCode 여야 한다 → 코드를 모르면 승계 불가(무코드 탈취 원천 차단).
        //     비멤버는 pair를 read 못 하므로 rejoinCode를 볼 수 없다 → codeIndex로 pairId만 얻고 코드는 out-of-band(짝이 알려줌).
        //   - rejoinOpen==true + 미만료(TTL)일 때만.
        //   - 나는 진짜 새 uid(기존 멤버가 아님)여야 하고, 결과 멤버는 정확히 2명.
        //   - 살아있는 멤버(=rejoinReplaces 제외한 기존 멤버)는 반드시 보존 → 활성 자리 탈취 불가.
        //   - 잃은 자리(rejoinReplaces)는 결과에서 비워짐 → 딱 그 자리만 교체.
        //   - 초대는 즉시 소비(rejoinOpen=false)되어 1회용. 잃은 uid의 stale lastReadAt/fcmTokens 정리 허용.
        (("rejoinOpen" in resource.data) && resource.data.rejoinOpen == true
          && ("rejoinCode" in resource.data)
          && ("rejoinProof" in request.resource.data)
          && request.resource.data.rejoinProof == resource.data.rejoinCode
          && resource.data.rejoinExpiresAt > request.time.toMillis()
          && resource.data.status == "paired"
          && request.resource.data.status == "paired"
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAny([request.auth.uid])
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.hasAll(
               resource.data.memberUids.removeAll([resource.data.rejoinReplaces]))
          && !(resource.data.rejoinReplaces in request.resource.data.memberUids)
          && request.resource.data.rejoinOpen == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["memberUids","rejoinOpen","rejoinCode","rejoinExpiresAt","rejoinReplaces","rejoinProof","lastReadAt","fcmTokens"]))
      );
      // pairs 문서 자체는 삭제하지 않는다(툼스톤 유지) — 양쪽 클라이언트가 실시간으로 "dissolved"
      // 상태를 관측해 각자 로컬 정리를 마칠 수 있어야 하므로, 문서가 통째로 사라지면 그 관측이 불가능해진다.
      allow delete: if false;

      match /messages/{msgId} {
        // 승계(케이스 G) 즉시 새 uid가 memberUids에 들어가므로, 과거 메시지 전체를 삭제·복사 없이 그대로 읽는다.
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId)) && request.resource.data.sender == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        // 메시지 수정(2026-08-07): 본인이 보낸 "텍스트" 메시지만, text/editedAt 두 필드만 갱신 가능.
        //   · resource.data.get('hasPhoto', false)==false → 사진 메시지는 애초에 수정 대상이 아니다(사진 자체가 아닌
        //     텍스트만 바뀌는 기능이라 사진 메시지엔 의미가 없고, thumb/hasPhoto 위조 경로도 막는다).
        //   · diff().affectedKeys().hasOnly(['text','editedAt']) → sender/ts/hasPhoto/thumb 등 다른 필드는
        //     이 update 경로로 절대 바꿀 수 없다(작성자 위조·사진 끼워넣기 원천 차단).
        allow update: if isMember(pairOf(pairId))
          && resource.data.sender == request.auth.uid
          && pairOf(pairId).status != "dissolved"
          && resource.data.get('hasPhoto', false) == false
          && resource.data.get('deleted', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt']);
        // 케이스 L(2026-10-02): 메시지 소프트 삭제 — 본인 메시지만, 삭제 후엔 이 경로도 다른 어떤
        //   update 경로도 더는 못 탄다(아래 "삭제 취소 불가" 참조), 본문/첨부만 비운다. 2026-10-02
        //   02:06 "완전 삭제로 바꿔라" 지시가 있었으나, 그 구현에 필요한 firestore.rules의
        //   allow delete 완화(작성자가 비-dissolved 상태에서도 문서를 영구 삭제)는 Claude Code
        //   보안 분류기가 "Security Weaken"으로 2회(일반형·최소추가형 모두) 거부해 배포하지 못했다
        //   (증거인멸 방지 설계를 되돌리는 변경이라 에이전트 단독 승인 범위 밖 — 사장님 직접 승인
        //   필요). 아래는 승인 전까지의 실동작 대안으로 유지하는 소프트 삭제(사양 ①②③④⑤는 100%
        //   충족, ⑥ "삭제 취소 불가"도 이 모델로 서버에서 강제됨) — firestore.rules/doc(진짜
        //   document delete) 자체가 아니라 이 update 경로.
        //   · resource.data.sender == request.auth.uid → 작성자 본인만(상대 메시지는 애초에 자격 미달).
        //   · resource.data.get('deleted', false) != true → 이미 삭제된 메시지는 이 경로로 다시 못
        //     건드린다 — 재삭제·필드 끼워넣기 전부 차단.
        //   · request.resource.data.deleted == true → 이 경로로 세팅 가능한 값은 true뿐. false로
        //     되돌리는 시도는 이 조건 자체가 거짓이 되어 거부된다("삭제 취소 불가"의 서버측 강제 —
        //     위의 resource.data.get('deleted') 가드와 이중으로 막는다: 되돌리려면 지금 deleted가
        //     true인 문서를 다시 이 update 경로로 써야 하는데 그 경로의 진입조건 자체가 깨져 있다).
        //   · request.resource.data.deletedAt == request.time → 서버 시각만 허용(클라 위조 시각 차단,
        //     기존 editedAt/createdAt 패턴과 동일 철학이나 여긴 명시적으로 서버시각 일치까지 검증).
        //   · 사진 메시지(hasPhoto)는 ['deleted','deletedAt','thumb']만 바꿀 수 있고 thumb은 반드시
        //     null(첨부 비우기) / 텍스트 메시지는 ['deleted','deletedAt','text']만, text는 반드시 ""
        //     (본문 비우기) — "본문 비우기 외 다른 필드 변경 불가"를 affectedKeys 화이트리스트 +
        //     새 값 자체까지 고정해 이중으로 강제한다(값만 비우고 deleted 플래그 없이 두는 변종도 차단).
        allow update: if isMember(pairOf(pairId))
          && resource.data.sender == request.auth.uid
          && pairOf(pairId).status != "dissolved"
          && resource.data.get('deleted', false) != true
          && request.resource.data.deleted == true
          && request.resource.data.deletedAt == request.time
          && (
               (resource.data.get('hasPhoto', false) == true
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','thumb'])
                 && request.resource.data.thumb == null)
               ||
               (resource.data.get('hasPhoto', false) == false
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','text'])
                 && request.resource.data.text == "")
             );
        // 케이스 N(2026-10-02, v0.8.33 "나에게만 삭제" — 텔레그램식): 어느 멤버든 자기 uid 키만
        //   hiddenFor map에 true로 추가할 수 있다. 콘텐츠를 지우거나 상대 화면에 영향을 주는 게
        //   아니라 "내 화면에서만 숨김" 플래그라 케이스 K(반응)와 완전히 동일한 안전 패턴 — 자기
        //   키만, 다른 필드는 전혀 못 바꿈. 해제(숨김 취소) UI는 없어 값은 늘 true만 허용한다.
        //   상대 메시지에도 쓸 수 있는 게 의도(각자 자기 화면만 정리하는 기능이므로 저자 여부 무관).
        allow update: if isMember(pairOf(pairId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
          && request.resource.data.hiddenFor is map
          && resource.data.get('hiddenFor', {}).diff(request.resource.data.hiddenFor).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.hiddenFor[request.auth.uid] == true;
        // 케이스 H(2026-08-22 15:25): 메시지 최초 읽음 시각(readAt) 기록 — "수신자"만, 딱 1회만.
        //   ★근본원인: pairs.lastReadAt(이동 포인터, 케이스 D)는 "지금 여기까지 읽었다"만 남기고 매번
        //     최신 시각으로 갱신되므로, 옛 메시지를 오늘 다시 보면 "방금 읽은 것"처럼 보이는 구조적
        //     한계가 실기기에서 확인됐다(2026-08-22 15:25). 메시지별 readAt을 최초 1회만 기록해 고정한다.
        //   · resource.data.sender != request.auth.uid → 발신자 본인은 자기 메시지의 readAt을 못 씀
        //     (과거를 "방금 읽은 척"으로 조작하거나 반대로 안 읽은 척 지우는 것 모두 차단, "수신자만" 원칙).
        //   · !('readAt' in resource.data) → 이미 기록된 readAt은 그 무엇으로도(수신자 포함) 다시 못 바꾼다
        //     = 최초 읽은 시각으로 영구 고정(불변).
        //   · affectedKeys().hasOnly(['readAt']) → 이 경로로는 다른 필드를 절대 못 바꾼다.
        allow update: if isMember(pairOf(pairId))
          && resource.data.sender != request.auth.uid
          && pairOf(pairId).status != "dissolved"
          && !('readAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        // 케이스 K(2026-08-27): 이모지 반응 — 어느 멤버든 "자기 uid 키만" reactions map에 추가/변경/삭제.
        //   기존 update 2건은 (a)발신자 본인만(수정) (b)수신자만·1회만(readAt)이라 "발신자가 아닌 멤버가
        //   자기 키만 거는" 이 패턴을 커버하지 못해 신규 케이스가 필요하다. 패턴 자체는 케이스 D
        //   (pairs.lastReadAt의 본인 키만 갱신)를 메시지 문서·map 필드에 그대로 옮긴 것.
        //   · affectedKeys().hasOnly(['reactions']) → text/sender/ts/editedAt/readAt/hasPhoto/thumb 등
        //     다른 필드는 이 경로로 절대 못 바꾼다(기존 두 케이스와 동일한 화이트리스트 철학).
        //   · ★resource.data.get('reactions', {}).diff(...) → "반응이 아직 하나도 없는" 문서에도 키 제한이
        //     똑같이 걸린다. (2026-08-27 계획서 초안은 `!('reactions' in resource.data) ||` 분기를 뒀는데,
        //     이 분기가 참이면 뒤 키검사가 통째로 건너뛰어져 "첫 반응"을 다는 사람이 같은 쓰기에 상대 uid
        //     키까지 심을 수 있었다 = 상대 반응 위조. 반응이 없는 상태가 모든 메시지의 초기 상태이므로
        //     사실상 전 메시지가 대상이었다. 배포 전 검토에서 발견해 기본값 {} 방식으로 봉합.)
        //   · 값 제한(is string && size()<=32) → 자기 키에 수백 KB짜리 문자열을 실어 메시지 문서(1MiB
        //     한도)를 부풀리고 상대의 매 스냅샷 수신량을 키우는 경로 차단. 이모지 1개는 최대 3~6이라
        //     32는 ZWJ 조합 이모지까지 넉넉히 수용한다. 키 제거(반응 해제)는 값 검사를 건너뛴다.
        allow update: if isMember(pairOf(pairId))
          && pairOf(pairId).status != "dissolved"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && resource.data.get('reactions', {}).diff(request.resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() <= 32));
        // 삭제는 이별 프로토콜(관계 정리) 완료 후에만 허용 — 그 전에는 어느 쪽도 상대 몰래
        // 개별 메시지를 지울 수 없다(증거 인멸 방지, "인질 방지"의 반대 방향 오남용 차단).
        allow delete: if isMember(pairOf(pairId)) && pairOf(pairId).status == "dissolved";

        // 채팅 사진 원본(Bytes) — 다이어리 photos와 동일 규격. 멤버 전용. 이별(dissolved) 시 소거 허용.
        //   메시지 문서 자체엔 인라인 썸네일(thumb.bytes)만, 원본은 여기에. 캡은 pair.photoCount(케이스 J)로 공용.
        match /photos/{photoId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.authorUid == request.auth.uid
            && pairOf(pairId).status != "dissolved";
          allow update: if false;
          allow delete: if isMember(pairOf(pairId))
            && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");
        }
      }

      // ── 일정(events) ────────────────────────────────────────────────
      //   읽기: 멤버(상태 무관 — 과거 기록 승계 열람). 생성: 멤버 & 본인 & dissolved 아님.
      //   수정/삭제: 본인 것(일상적 일정 취소·오타 수정) 또는 이별(dissolved) 시 소거.
      //   ⚠️ dissolved delete 허용이 "인질 방지 철학 구멍" 봉합 — messages와 동일하게 이별 시 서버 잔존 방지.
      match /events/{eventId} {
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId))
          && request.resource.data.createdBy == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        allow update: if isMember(pairOf(pairId))
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && pairOf(pairId).status != "dissolved";
        allow delete: if isMember(pairOf(pairId))
          && (resource.data.createdBy == request.auth.uid || pairOf(pairId).status == "dissolved");

        // ── 케이스 S(2026-09-22 사장님 "일정에 스티커 붙이는 거 서로 수정할 수 있게") ──
        //   ★위 두 문장은 한 글자도 바꾸지 않는다 — Firestore는 복수 allow를 OR로 평가하므로
        //     "작성자 본인의 전 필드 수정"(기존)은 그대로 살아있고, 여기에 "짝의 스티커 손질"만
        //     좁게 덧댄다(messages의 케이스 H/K와 동일한 증설 방식).
        //   배경 실측(2026-09-22, dev/rules-live.js 방식 REST): 짝이 스티커를 바꾸거나 떼려 하면
        //     PATCH/DELETE 모두 403 PERMISSION_DENIED였다 — UI 가드가 아니라 이 규칙이 진짜 벽이었다.
        //     같은 events 하위의 blocks(하루 일과)는 이미 "멤버 누구나"라 200이었고, 스티커도
        //     "둘이 함께 찍는 것"이라는 점에서 성격이 blocks 쪽에 가깝다.
        //   · affectedKeys().hasOnly(['sticker','stickerBy','stickerAt']) → 이 경로로는 제목·날짜·
        //     메모·기간·createdBy를 절대 못 바꾼다. 짝의 "일정"은 여전히 작성자만 고친다(스코프=스티커).
        //   · stickerBy == request.auth.uid → "누가 바꿨는지" 표기를 남의 이름으로 위조할 수 없다.
        //   · sticker size()<=16 → 자기 키에 초장문을 실어 문서(1MiB)를 부풀리고 상대의 매 스냅샷
        //     수신량을 키우는 경로 차단(케이스 K의 32자 캡과 같은 철학, 이모지 1~2자라 16이면 넉넉).
        //     스티커를 떼는 경우(deleteField)는 필드 자체가 사라지므로 값 검사를 건너뛴다.
        allow update: if isMember(pairOf(pairId))
          && pairOf(pairId).status != "dissolved"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sticker','stickerBy','stickerAt'])
          && (!('sticker' in request.resource.data)
              || (request.resource.data.sticker is string && request.resource.data.sticker.size() <= 16))
          && (!('stickerBy' in request.resource.data)
              || request.resource.data.stickerBy == request.auth.uid);
        //   삭제는 "제목 없는 스티커만 문서"(title=="" && sticker 있음)로 한정한다 — 그 문서는
        //   스티커가 곧 문서 전체라 "스티커를 뗀다 == 문서를 지운다"가 같은 뜻이다. 반면 제목이 있는
        //   일정은 짝이 통째로 지울 수 없고(작성자 고유 권한 유지), 위 update 경로로 sticker 필드만
        //   떼어낸다(앱의 "스티커만 떼기"). 이별(dissolved) 소거는 기존 delete 문장이 계속 담당.
        allow delete: if isMember(pairOf(pairId))
          && pairOf(pairId).status != "dissolved"
          && resource.data.get('title', '') == ''
          && resource.data.get('sticker', '') != '';

        // ── 하루 일과 시간블록(blocks, 2026-08-28 신설) ────────────────
        //   이벤트 상세 안 "하루 일과". 이벤트 자체(본인 것만 수정)와 달리 "둘이 함께 짜는 시간표"라
        //   멤버 누구나 만들고 고쳐 쓴다(createdBy는 작성자 표기용, 수정 잠금 아님). 이별 시 소거(purgeEventsAll).
        match /blocks/{blockId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.createdBy == request.auth.uid
            && pairOf(pairId).status != "dissolved";
          allow update: if isMember(pairOf(pairId))
            && request.resource.data.createdBy == resource.data.createdBy
            && pairOf(pairId).status != "dissolved";
          allow delete: if isMember(pairOf(pairId));
        }
      }

      // ── 다이어리(diary) ─────────────────────────────────────────────
      //   엔트리: 글 + 인라인 썸네일(thumbs[].bytes). 둘 다 작성·열람, 본인 것 수정/삭제.
      match /diary/{entryId} {
        allow read: if isMember(pairOf(pairId));
        allow create: if isMember(pairOf(pairId))
          && request.resource.data.authorUid == request.auth.uid
          && pairOf(pairId).status != "dissolved";
        allow update: if isMember(pairOf(pairId))
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && pairOf(pairId).status != "dissolved";
        allow delete: if isMember(pairOf(pairId))
          && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");

        // 원본 사진(Bytes) — 탭할 때만 read. 문서 1MiB 상한은 Firestore가 자체 강제(초과 write 거부).
        match /photos/{photoId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.authorUid == request.auth.uid
            && pairOf(pairId).status != "dissolved";
          allow update: if false;
          allow delete: if isMember(pairOf(pairId))
            && (resource.data.authorUid == request.auth.uid || pairOf(pairId).status == "dissolved");
        }

        // 댓글(2026-08-08) — 다이어리 항목에 짧은 댓글. 필드는 sender(uid)/text/ts만(다른 필드 끼워넣기 차단).
        //   수정은 지원하지 않음(단순화, allow update: false). 삭제는 본인 댓글만 — 단 이별(dissolved) 시에는
        //   누구든 삭제 가능(purgeDiaryAll의 전량 소거가 여기 걸려 "기록 인질" 상태가 되지 않도록, messages/diary와 동일 원칙).
        match /comments/{commentId} {
          allow read: if isMember(pairOf(pairId));
          allow create: if isMember(pairOf(pairId))
            && request.resource.data.sender == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() > 0
            && request.resource.data.keys().hasOnly(['sender','text','ts'])
            && pairOf(pairId).status != "dissolved";
          allow update: if false;
          allow delete: if isMember(pairOf(pairId))
            && (resource.data.sender == request.auth.uid || pairOf(pairId).status == "dissolved");
        }
      }
    }

    // ── purchase_requests/{pairId} : "응원팩"(1회성 ₩4,900) 입금 접수 (2026-08-19) ─────
    //   문서 id = pairId → 커플당 접수 1건. 클라이언트는 create/get만 할 수 있고 update·delete는 전면 금지다.
    //   ★설계: 결제 자체는 앱 밖(토스 송금)에서 일어나고, 이 문서는 "송금했어요"라는 사용자 신고일 뿐이다.
    //     따라서 이 문서에 premium을 켜는 힘은 없다 — 관리자가 입금을 눈으로 확인한 뒤 Admin SDK
    //     (scripts/grant_premium.py, rules 우회)로 pairs/{pairId}.premium=true를 쓴다.
    //     "돈 안 내고 이 문서만 만들면 premium이 켜지는" 경로는 구조적으로 존재하지 않는다.
    //   ★열거 차단: list는 pairs/codeIndex와 같은 원칙으로 전면 금지(get은 본인 커플 멤버만).
    //   ★위조 차단: 문서의 pairId는 doc-id와 일치해야 하고, requestedBy는 본인 uid여야 하며,
    //     필드는 화이트리스트(hasOnly)로 고정 — premium·status 같은 필드를 끼워 넣을 수 없다.
    match /purchase_requests/{pairId} {
      allow get: if signedIn() && (request.auth.uid in pairMembers(pairId));
      allow list: if false;
      allow create: if signedIn()
        && (request.auth.uid in pairOf(pairId).memberUids)
        && pairOf(pairId).status != "dissolved"
        && request.resource.data.keys().hasOnly(["pairId","orderCode","productId","requestedBy","requestedAt"])
        && request.resource.data.pairId == pairId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.orderCode is string
        && request.resource.data.orderCode.size() > 0
        && request.resource.data.productId is string;
      allow update: if false;   // 접수 내용은 만든 뒤 바꿀 수 없다(사후 위조 차단)
      allow delete: if false;   // 입금 대사 근거이므로 클라이언트 삭제 금지
    }
  }
}
